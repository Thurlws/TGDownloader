# ── Telegram credentials & session data (NEVER commit these) ──────────────
tg_audio_config.json
tg_audio_session.session
tg_audio_session.session-journal
*.session
*.session-journal

# ── Runtime data (generated locally, not needed in repo) ──────────────────
hash_cache.json
album_id_cache.json
library_stats_cache.json
bpm_cache.json
liked_songs.json
ratings.json
watchlist.json
tg_sessions.json
play_history.jsonl
# SQLite state store (v1.18.0) + its WAL sidecars and migration backups
tgd_state.db
tgd_state.db-wal
tgd_state.db-shm
*.pre-sqlite.bak
# Per-bot first-run flags: bot_initialized.flag (legacy) + bot_initialized_<name>.flag
bot_initialized*.flag
tgdownloader_debug.log
pause.flag

# ── Personal knowledge base 
TGDownloader Context Vault/

# ── Temp download directories & runtime caches ───────────────────────────
tg_tmp_downloads/
tg_transcode_cache/
tg_waveform_cache/
# Isolated Chromium profile for the --app window (created next to the exe)
browser_profile/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
env/
.venv/

# ── Test / lint caches ────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/

# ── PyInstaller bundle output ─────────────────────────────────────────────
# (dist/ and build/ are already ignored under Python above)
*.spec
!TGDownloader.spec

# ── In-place self-updater leftovers (frozen Windows build writes these) ───
_update/
_update.zip
_apply_update.bat
_internal.old/
TGDownloader.old.exe

# ── OS junk ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / local tooling ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.claude/
